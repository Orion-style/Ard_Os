#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  ard-install --disk /dev/nvme0n1 --hostname ard-os --username ard

Options:
  --disk       Target disk. This disk will be erased.
  --hostname   Installed system hostname. Default: ard-os
  --username   Normal desktop user to create. Default: ard
  --password-file
               File containing the password for the created user.
  --timezone   Timezone. Default: UTC
  --locale     Locale. Default: en_US.UTF-8
  --confirm-erase
               Required for non-interactive installs. Skips the ERASE prompt.
  --help       Show this help.

This installer targets UEFI systems and creates:
  1. 1 GiB FAT32 EFI system partition
  2. btrfs root partition mounted as /
  3. btrfs home partition mounted as /home
EOF
}

disk=""
hostname="ard-os"
username="ard"
password_file=""
timezone="UTC"
locale="en_US.UTF-8"
confirm_erase="no"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --disk)
      disk="${2:-}"
      shift 2
      ;;
    --hostname)
      hostname="${2:-}"
      shift 2
      ;;
    --username)
      username="${2:-}"
      shift 2
      ;;
    --password-file)
      password_file="${2:-}"
      shift 2
      ;;
    --timezone)
      timezone="${2:-}"
      shift 2
      ;;
    --locale)
      locale="${2:-}"
      shift 2
      ;;
    --confirm-erase)
      confirm_erase="yes"
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage
      exit 2
      ;;
  esac
done

if [[ "$(id -u)" -ne 0 ]]; then
  echo "Run as root." >&2
  exit 1
fi

if [[ -z "$disk" || ! -b "$disk" ]]; then
  echo "A valid --disk block device is required." >&2
  usage
  exit 2
fi

if [[ "$username" == "root" || ! "$username" =~ ^[a-z_][a-z0-9_-]*[$]?$ ]]; then
  echo "--username must be a normal Linux account name and cannot be root." >&2
  exit 2
fi

if [[ "$hostname" != "${hostname//[^A-Za-z0-9-]/}" || "$hostname" == -* || "$hostname" == *- || -z "$hostname" ]]; then
  echo "--hostname must contain only letters, numbers, and hyphens, and cannot start or end with a hyphen." >&2
  exit 2
fi

if [[ -n "$password_file" && ! -r "$password_file" ]]; then
  echo "--password-file must be readable." >&2
  exit 2
fi

if [[ -n "$password_file" ]] && grep -q ':' "$password_file"; then
  echo "Password cannot contain ':'." >&2
  exit 2
fi

if [[ ! -d /sys/firmware/efi ]]; then
  echo "UEFI firmware is required for this installer." >&2
  exit 1
fi

parent_disk() {
  local dev="$1"
  local pkname
  pkname="$(lsblk -no PKNAME "$dev" 2>/dev/null | head -n 1 | tr -d '[:space:]')"
  if [[ -n "$pkname" ]]; then
    printf '/dev/%s\n' "$pkname"
  else
    readlink -f "$dev"
  fi
}

live_source="$(findmnt -n -o SOURCE /run/archiso/bootmnt 2>/dev/null || true)"
if [[ -n "$live_source" && -b "$live_source" ]]; then
  live_disk="$(parent_disk "$live_source")"
  target_disk="$(readlink -f "$disk")"
  if [[ "$target_disk" == "$live_disk" ]]; then
    echo "Refusing to install to the current live USB device: $disk" >&2
    exit 2
  fi
fi

if ! curl -I --max-time 10 https://archlinux.org >/dev/null 2>&1; then
  echo "Internet connection is required before installation because pacstrap downloads packages from Arch mirrors." >&2
  echo "Connect Wi-Fi or Ethernet, then start the installer again." >&2
  exit 1
fi

echo "Target disk: $disk"
lsblk -dn -o NAME,SIZE,MODEL,TYPE,RM "$disk"
echo "Hostname:    $hostname"
echo "Username:    $username"
echo "User model:  root is for administration; $username is for desktop, games, and launchers."
echo
lsblk "$disk"
echo
if [[ "$confirm_erase" != "yes" ]]; then
  read -r -p "Type ERASE to destroy all data on $disk and install FlasterOS: " confirm
  if [[ "$confirm" != "ERASE" ]]; then
    echo "Install cancelled."
    exit 1
  fi
fi

if [[ "$disk" =~ [0-9]$ ]]; then
  efi_part="${disk}p1"
  root_part="${disk}p2"
  home_part="${disk}p3"
else
  efi_part="${disk}1"
  root_part="${disk}2"
  home_part="${disk}3"
fi

disk_size_bytes="$(lsblk -b -dn -o SIZE "$disk" | tr -d '[:space:]')"
disk_size_mib="$((disk_size_bytes / 1024 / 1024))"
efi_end_mib=1025
minimum_disk_mib=262144
minimum_home_mib=32768
if (( disk_size_mib < minimum_disk_mib )); then
  echo "Target disk must be at least 256 GiB for Ard OS Gaming." >&2
  exit 2
fi
available_mib="$((disk_size_mib - efi_end_mib))"
root_size_mib="$((available_mib * 85 / 100))"
if (( root_size_mib < 204800 )); then
  root_size_mib=204800
fi
if (( available_mib - root_size_mib < minimum_home_mib )); then
  root_size_mib="$((available_mib - minimum_home_mib))"
fi
root_end_mib="$((efi_end_mib + root_size_mib))"

timedatectl set-ntp true || true

swapoff --all || true
umount -R /mnt 2>/dev/null || true

sgdisk --zap-all "$disk"
parted --script "$disk" \
  mklabel gpt \
  mkpart ESP fat32 1MiB 1025MiB \
  set 1 esp on \
  name 1 EFI \
  mkpart ROOT btrfs 1025MiB "${root_end_mib}MiB" \
  name 2 ArdRoot \
  mkpart HOME btrfs "${root_end_mib}MiB" 100% \
  name 3 ArdHome
partprobe "$disk"
udevadm settle

mkfs.fat -F32 "$efi_part"
mkfs.btrfs -f -L ARDROOT "$root_part"
mkfs.btrfs -f -L ARDHOME "$home_part"

mount "$root_part" /mnt
btrfs subvolume create /mnt/@
btrfs subvolume create /mnt/@games
btrfs subvolume create /mnt/@var_log
btrfs subvolume create /mnt/@snapshots
umount /mnt

mount -o noatime,compress=zstd,subvol=@ "$root_part" /mnt
mount --mkdir -o noatime,compress=zstd "$home_part" /mnt/home
mount --mkdir -o noatime,compress=zstd,subvol=@games "$root_part" /mnt/games
mount --mkdir -o noatime,compress=zstd,subvol=@var_log "$root_part" /mnt/var/log
mount --mkdir -o noatime,compress=zstd,subvol=@snapshots "$root_part" /mnt/.snapshots
mount --mkdir "$efi_part" /mnt/boot

pacstrap -K /mnt \
  base linux linux-firmware \
  btrfs-progs networkmanager sudo vim nano pciutils usbutils jq pacman-contrib qemu-guest-agent spice-vdagent virtualbox-guest-utils \
  bluez bluez-utils bluedevil steam-devices \
  alsa-utils sof-firmware \
  pipewire pipewire-alsa pipewire-audio pipewire-jack pipewire-pulse wireplumber \
  plasma-desktop plasma-nm sddm konsole dolphin firefox \
  plasma-pa plasma-workspace power-profiles-daemon xorg-server xorg-xwayland xorg-xrandr \
  plymouth python tk \
  mesa mesa-utils lib32-mesa vulkan-icd-loader lib32-vulkan-icd-loader \
  vulkan-intel vulkan-radeon lib32-vulkan-intel lib32-vulkan-radeon vulkan-tools \
  wine wine-gecko wine-mono winetricks steam \
  vkd3d lib32-vkd3d mangohud lib32-mangohud gamemode lib32-gamemode gamescope \
  intel-ucode amd-ucode zram-generator

install -Dm644 /etc/pacman.conf /mnt/etc/pacman.conf
sed -i '/^\#\[multilib\]/,+1 s/^#//' /mnt/etc/pacman.conf

genfstab -U /mnt >> /mnt/etc/fstab

install -Dm755 /usr/local/bin/ard-create-game /mnt/usr/local/bin/ard-create-game
install -Dm755 /usr/local/bin/ard-run-game /mnt/usr/local/bin/ard-run-game
install -Dm755 /usr/local/bin/ard-launcher /mnt/usr/local/bin/ard-launcher
install -Dm755 /usr/local/bin/ard-settings-center /mnt/usr/local/bin/ard-settings-center
install -Dm755 /usr/local/bin/ard-check-system /mnt/usr/local/bin/ard-check-system
install -Dm755 /usr/local/bin/ard-snapshot /mnt/usr/local/bin/ard-snapshot
install -Dm755 /usr/local/bin/ard-gaming-session /mnt/usr/local/bin/ard-gaming-session
install -Dm755 /usr/local/bin/ard-install-gpu-drivers /mnt/usr/local/bin/ard-install-gpu-drivers
install -Dm755 /usr/local/bin/ard-install-gaming-compat /mnt/usr/local/bin/ard-install-gaming-compat
install -Dm755 /usr/local/bin/ard-setup-wine-dxvk /mnt/usr/local/bin/ard-setup-wine-dxvk
install -Dm755 /usr/local/bin/ard-prepare-proton /mnt/usr/local/bin/ard-prepare-proton
install -Dm644 /etc/os-release /mnt/etc/os-release
install -Dm644 /etc/skel/.config/kdeglobals /mnt/etc/skel/.config/kdeglobals
install -Dm644 /etc/skel/.config/kscreenlockerrc /mnt/etc/skel/.config/kscreenlockerrc
install -Dm644 /etc/skel/.config/plasma-org.kde.plasma.desktop-appletsrc /mnt/etc/skel/.config/plasma-org.kde.plasma.desktop-appletsrc
install -Dm755 /opt/ard-os/launcher/ard-launcher.py /mnt/opt/ard-os/launcher/ard-launcher.py
install -Dm755 /opt/ard-os/settings/ard-settings-center.py /mnt/opt/ard-os/settings/ard-settings-center.py
install -Dm755 /opt/ard-os/diagnostics/ard-diagnostics.py /mnt/opt/ard-os/diagnostics/ard-diagnostics.py
install -Dm644 /usr/share/flasteros/branding/flasteros-logo.svg /mnt/usr/share/flasteros/branding/flasteros-logo.svg
install -Dm644 /usr/share/flasteros/branding/flasteros-wallpaper.svg /mnt/usr/share/flasteros/branding/flasteros-wallpaper.svg
install -Dm644 /usr/share/icons/hicolor/scalable/apps/flasteros.svg /mnt/usr/share/icons/hicolor/scalable/apps/flasteros.svg
install -Dm644 /etc/plymouth/plymouthd.conf /mnt/etc/plymouth/plymouthd.conf
install -Dm644 /usr/share/plymouth/themes/flasteros/flasteros.plymouth /mnt/usr/share/plymouth/themes/flasteros/flasteros.plymouth
install -Dm644 /usr/share/plymouth/themes/flasteros/flasteros.script /mnt/usr/share/plymouth/themes/flasteros/flasteros.script
install -Dm644 /etc/sddm.conf.d/20-flasteros-theme.conf /mnt/etc/sddm.conf.d/20-flasteros-theme.conf
install -Dm644 /usr/share/sddm/themes/flasteros/theme.conf /mnt/usr/share/sddm/themes/flasteros/theme.conf
install -Dm644 /usr/share/sddm/themes/flasteros/metadata.desktop /mnt/usr/share/sddm/themes/flasteros/metadata.desktop
install -Dm644 /usr/share/sddm/themes/flasteros/Main.qml /mnt/usr/share/sddm/themes/flasteros/Main.qml
install -Dm644 /usr/share/applications/ard-launcher.desktop /mnt/usr/share/applications/ard-launcher.desktop
install -Dm644 /usr/share/applications/ard-settings-center.desktop /mnt/usr/share/applications/ard-settings-center.desktop
install -Dm644 /usr/share/applications/ard-diagnostics.desktop /mnt/usr/share/applications/ard-diagnostics.desktop
install -Dm644 /usr/share/xsessions/ard-gaming.desktop /mnt/usr/share/xsessions/ard-gaming.desktop
install -Dm644 /usr/share/xsessions/ard-desktop.desktop /mnt/usr/share/xsessions/ard-desktop.desktop
install -Dm644 /etc/systemd/zram-generator.conf /mnt/etc/systemd/zram-generator.conf

arch-chroot /mnt /bin/bash <<EOF
set -euo pipefail
ln -sf /usr/share/zoneinfo/$timezone /etc/localtime
hwclock --systohc
sed -i 's/^#\\($locale UTF-8\\)/\\1/' /etc/locale.gen
locale-gen
printf 'LANG=$locale\n' > /etc/locale.conf
printf '$hostname\n' > /etc/hostname
cat > /etc/hosts <<HOSTS
127.0.0.1 localhost
::1 localhost
127.0.1.1 $hostname.localdomain $hostname
HOSTS
bootctl install
cat > /boot/loader/loader.conf <<LOADER
default ard-os.conf
timeout 3
console-mode max
editor no
LOADER
root_uuid="\$(blkid -s UUID -o value "$root_part")"
cat > /boot/loader/entries/ard-os.conf <<ENTRY
title FlasterOS
linux /vmlinuz-linux
initrd /intel-ucode.img
initrd /amd-ucode.img
initrd /initramfs-linux.img
options root=UUID=\$root_uuid rootflags=subvol=@ rw quiet splash
ENTRY
plymouth-set-default-theme flasteros || true
if ! grep -q ' plymouth ' /etc/mkinitcpio.conf; then
  sed -i 's/ filesystems/ plymouth filesystems/' /etc/mkinitcpio.conf
fi
mkinitcpio -P
systemctl enable NetworkManager.service
systemctl enable sddm.service
systemctl enable power-profiles-daemon.service || true
systemctl enable bluetooth.service || true
virt="\$(systemd-detect-virt || true)"
if [[ "\$virt" == "qemu" || "\$virt" == "kvm" ]]; then
  systemctl enable qemu-guest-agent.service || true
  systemctl enable spice-vdagentd.service || true
elif [[ "\$virt" == "oracle" ]]; then
  systemctl enable vboxservice.service || true
fi
useradd -m -G wheel -s /bin/bash "$username"
install -d -m 0755 /opt/ard-os
install -d -m 0775 -o "$username" -g wheel /games
install -d -m 0755 /var/log/ard-os
sed -i 's/^# %wheel ALL=(ALL:ALL) ALL/%wheel ALL=(ALL:ALL) ALL/' /etc/sudoers
EOF

if [[ -n "$password_file" ]]; then
  user_password="$(tr -d '\r\n' < "$password_file")"
  printf '%s:%s\n' "$username" "$user_password" | arch-chroot /mnt chpasswd
  arch-chroot /mnt passwd -l root
else
  arch-chroot /mnt passwd "$username"
  arch-chroot /mnt passwd -l root
fi

arch-chroot /mnt /usr/local/bin/ard-snapshot pre-update

umount -R /mnt
echo "FlasterOS install complete. Reboot and remove the USB drive."
echo "Use $username for normal work, games, and launchers. Use root only for administration."
